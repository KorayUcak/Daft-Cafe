# ============================================
# Daft Coffee — Ortam Değişkenleri
# ============================================
# Bu dosyayı ".env" olarak kopyalayıp değerleri güncelleyiniz.
#   cp .env.example .env

# Sunucu portu
PORT=3000

# Çalışma ortamı (development | production)
NODE_ENV=development

# Admin paneli şifresi
# ÖNEMLİ: Production ortamında bu değeri mutlaka değiştirin!
ADMIN_PASSWORD=change_me

# Session şifreleme anahtarı
# ÖNEMLİ: Güvenli, rastgele bir dize kullanın.
SESSION_SECRET=change_me_to_a_random_secret
