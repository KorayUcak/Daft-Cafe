<%- include('../partials/admin-header') %>

<section class="admin-panel">

  <!-- Header -->
  <div class="admin-header">
    <h1>admin paneli</h1>
    <a href="/admin/cikis" class="btn btn-small btn-secondary">🔒 Çıkış</a>
  </div>

  <!-- Alerts -->
  <% if (mesaj) { %>
    <div class="alert alert-success">✅ <%= mesaj %></div>
  <% } %>
  <% if (hataMesaji) { %>
    <div class="alert alert-danger">❌ <%= hataMesaji %></div>
  <% } %>

  <!-- İstatistikler -->
  <div class="admin-stats">
    <div class="stat-card">
      <span class="stat-number"><%= urunler.length %></span>
      <span class="stat-label">Toplam Ürün</span>
    </div>
    <div class="stat-card">
      <span class="stat-number"><%= kategoriler.length %></span>
      <span class="stat-label">Kategori</span>
    </div>
  </div>

  <!-- ===== YENİ ÜRÜN EKLE ===== -->
  <div class="admin-form-card">
    <h2 class="admin-form-title">+ yeni ürün ekle</h2>
    <form action="/admin/ekle" method="POST" enctype="multipart/form-data">
      <div class="admin-form-row">
        <div class="form-group">
          <label for="isim">Ürün Adı</label>
          <input type="text" id="isim" name="isim" placeholder="Örn: Türk Kahvesi" required>
        </div>
        <div class="form-group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori" required>
            <option value="">Seçiniz...</option>
            <option value="kahve">Kahve</option>
            <option value="tatli">Tatlı</option>
            <option value="soguk-icecek">Soğuk İçecek</option>
          </select>
        </div>
        <div class="form-group">
          <label for="fiyat">Fiyat (₺)</label>
          <input type="number" id="fiyat" name="fiyat" step="0.01" min="0" placeholder="45.00" required>
        </div>
        <div class="form-group">
          <label for="image">Fotoğraf</label>
          <input type="file" id="image" name="image" accept="image/*">
          <span class="form-help">Maks. 5MB — JPEG, PNG, GIF, WEBP</span>
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          <label for="description">Ürün İçeriği / Açıklama</label>
          <textarea id="description" name="description" placeholder="Örn: %100 Arabica çekirdekleri, taze süt ve karamel şurubu." rows="2"></textarea>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Ürünü Ekle</button>
    </form>
  </div>

  <!-- ===== ÜRÜN LİSTESİ (Kart tabanlı — tablo yerine) ===== -->
  <% if (urunler.length === 0) { %>
    <div class="empty-msg">Henüz ürün eklenmemiş.</div>
  <% } else { %>
    <div class="admin-products">
      <% urunler.forEach(function(urun) { %>
        <div class="admin-product-card">
          <!-- Görsel -->
          <% if (urun.imagePath) { %>
            <img src="<%= urun.imagePath %>" alt="<%= urun.isim %>" class="admin-product-thumb">
          <% } else { %>
            <div class="admin-product-thumb-placeholder">📷</div>
          <% } %>

          <!-- Bilgi + İşlemler -->
          <div class="admin-product-info">
            <div class="admin-product-name"><%= urun.isim %></div>
            <div class="admin-product-meta">
              <span class="badge"><%= urun.kategori %></span>
              <span class="admin-product-price"> · <%= urun.fiyat %> ₺</span>
            </div>

            <!-- Aksiyon butonları -->
            <div class="admin-product-actions">
              <!-- Hızlı fiyat güncelle -->
              <form action="/admin/fiyat/<%= urun.id %>" method="POST" class="inline-price-form">
                <input type="number" name="fiyat" step="0.01" min="0" value="<%= urun.fiyat %>" class="price-input" required>
                <button type="submit" class="btn btn-small btn-secondary" title="Fiyatı Güncelle">✓</button>
              </form>

              <!-- Sil -->
              <form action="/admin/sil/<%= urun.id %>" method="POST" onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?\n\nÜrün: <%= urun.isim %>')">
                <button type="submit" class="btn btn-small btn-danger">🗑️ Sil</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- ===== KAMPANYALAR BÖLÜMÜ ===== -->
  <div class="admin-header" style="margin-top: 40px;">
    <h2>Kampanyalar</h2>
  </div>

  <!-- Kampanya Ekle Formu -->
  <div class="admin-form-card">
    <h3 class="admin-form-title">+ yeni kampanya ekle</h3>
    <form action="/admin/kampanya/ekle" method="POST" enctype="multipart/form-data">
      <div class="admin-form-row">
        <div class="form-group">
          <label for="kampanya_isim">Kampanya Başlığı</label>
          <input type="text" id="kampanya_isim" name="isim" placeholder="Örn: Kahve & Tatlı İkilisi" required>
        </div>
        <div class="form-group">
          <label for="kampanya_fiyat">Fiyat (₺)</label>
          <input type="number" id="kampanya_fiyat" name="fiyat" step="0.01" min="0" placeholder="75.00" required>
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          <label for="kampanya_image">Fotoğraf (Tercihen 1x1 veya yatay)</label>
          <input type="file" id="kampanya_image" name="image" accept="image/*">
          <span class="form-help">Maks. 5MB — JPEG, PNG, WEBP</span>
        </div>
        <div class="form-group" style="grid-column: 1 / -1;">
          <label for="kampanya_desc">Kampanya İçeriği / Açıklama</label>
          <textarea id="kampanya_desc" name="description" placeholder="Örn: Seçtiğiniz herhangi bir kahve ve dilim pasta." rows="2"></textarea>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Kampanya Ekle</button>
    </form>
  </div>

  <!-- Kampanyalar Listesi -->
  <% if (locals.kampanyalar && locals.kampanyalar.length === 0) { %>
    <div class="empty-msg">Henüz kampanya eklenmemiş.</div>
  <% } else if (locals.kampanyalar) { %>
    <div class="admin-products">
      <% locals.kampanyalar.forEach(function(kampanya) { %>
        <div class="admin-product-card">
          <% if (kampanya.imagePath) { %>
            <img src="<%= kampanya.imagePath %>" alt="<%= kampanya.isim %>" class="admin-product-thumb">
          <% } else { %>
            <div class="admin-product-thumb-placeholder">📷</div>
          <% } %>
          <div class="admin-product-info">
            <div class="admin-product-name"><%= kampanya.isim %></div>
            <div class="admin-product-meta">
              <span class="admin-product-price"><%= kampanya.fiyat %> ₺</span>
            </div>
            <!-- Aksiyon butonları -->
            <div class="admin-product-actions">
              <form action="/admin/kampanya/sil/<%= kampanya.id %>" method="POST" onsubmit="return confirm('Silmek istediğinize emin misiniz?\n\nKampanya: <%= kampanya.isim %>')">
                <button type="submit" class="btn btn-small btn-danger">🗑️ Sil</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</section>

<%- include('../partials/admin-footer') %>
