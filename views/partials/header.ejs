<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Daft Coffee — Zanaatkar kahve deneyimi. Taze kahve, özel tatlılar ve serinleten içecekler.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="site-header">
    <nav class="navbar">

      <!-- Brand Group (Left Side) -->
      <div class="nav-brand-group" style="display: flex; align-items: center; gap: 20px;">
        
        <!-- Language Dropdown -->
        <div class="lang-dropdown-wrapper">
          <button class="lang-dropdown-toggle" id="langToggle">
            <span id="currentLang">TR</span>
            <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="lang-dropdown-menu" id="langMenu">
            <span class="lang-opt active" data-lang="tr">TR</span>
            <span class="lang-opt" data-lang="en">EN</span>
            <span class="lang-opt" data-lang="es">ES</span>
            <span class="lang-opt" data-lang="de">DE</span>
            <span class="lang-opt" data-lang="ru">RU</span>
          </div>
        </div>
      </div>

      <!-- Nav — Pure Text Editorial (No Hamburger) -->
      <ul class="nav-links">
        <li><a href="#menu" data-i18n="nav.menu">Menü</a></li>
        <li><a href="#about" data-i18n="nav.about">Hakkımızda</a></li>
      </ul>

    </nav>
  </header>

  <!-- ===== PREMIUM MARQUEE TICKER ===== -->
  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      <span>daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;</span>
      <span>daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;daft&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>

  <!-- Dropdown Toggle + Outside-Click-to-Close Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const wrapper = document.querySelector('.lang-dropdown-wrapper');
      const toggle = document.getElementById('langToggle');
      const label = document.getElementById('currentLang');
      const opts = document.querySelectorAll('.lang-dropdown-menu .lang-opt');

      // Toggle open/close on button click
      if (toggle && wrapper) {
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          wrapper.classList.toggle('open');
        });
      }

      // Auto-close on language selection
      opts.forEach(opt => {
        opt.addEventListener('click', () => {
          if (label) label.textContent = opt.textContent;
          if (wrapper) wrapper.classList.remove('open');
        });
      });

      // Close on any outside click
      document.addEventListener('click', (e) => {
        if (wrapper && !wrapper.contains(e.target)) {
          wrapper.classList.remove('open');
        }
      });
    });
  </script>

  <main class="container">
