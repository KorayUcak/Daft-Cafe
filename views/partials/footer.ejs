<!-- i18n Translation System -->
<script src="/js/i18n.js"></script>

<script>
  // ──────────────────────────────────────────
  // Smart Map Routing — iOS → Apple Maps, else → Google Maps
  // ──────────────────────────────────────────
  (function() {
    const link = document.getElementById('directionsLink');
    if (!link) return;
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                  (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (isIOS) {
      link.href = 'http://maps.apple.com/?q=Alsancak+Mahallesi+1480+sokak+No:10,+%C4%B0zmir';
    }
    // Non-iOS keeps the default Google Maps href
  })();

  // ──────────────────────────────────────────
  // IntersectionObserver — Premium scroll reveal
  // ──────────────────────────────────────────
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        revealObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.06}s`;
    revealObserver.observe(el);
  });
</script>

