<script>
  // ──────────────────────────────────────────
  // IntersectionObserver — scroll animasyonları
  // ──────────────────────────────────────────
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('fade-in-up');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.menu-card, .kategori-section, .admin-product-card').forEach(el => {
    el.style.opacity = '0';
    obs.observe(el);
  });

  // ──────────────────────────────────────────
  // 3D LED Tabela — Mousemove Tilt Efekti
  // (Masaüstünde fare ile, mobilde yavaş dönüş)
  // ──────────────────────────────────────────
  (function () {
    const sign = document.getElementById('ledSign');
    const hero = document.getElementById('heroSection');
    if (!sign || !hero) return;

    const isMobile = window.matchMedia('(max-width: 959px)').matches;

    if (isMobile) {
      // Mobil — yavaş otomatik sallanma
      let t = 0;
      function mobileFloat() {
        t += 0.008;
        const rx = Math.sin(t) * 2;
        const ry = Math.cos(t * 0.7) * 3;
        sign.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
        requestAnimationFrame(mobileFloat);
      }
      mobileFloat();
    } else {
      // Masaüstü — fare takip tilt
      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const mx = e.clientX - cx;
        const my = e.clientY - cy;
        const rx = (my / rect.height) * -8;
        const ry = (mx / rect.width) * 8;
        sign.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
      });
      hero.addEventListener('mouseleave', () => {
        sign.style.transform = 'rotateX(0) rotateY(0)';
      });
    }
  })();
</script>

</body>

