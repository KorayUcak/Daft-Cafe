<%- include('partials/header') %>

<!-- ===== HERO — AYDINLIK 3D LED TABELA ===== -->
<section class="hero-artisan" id="heroSection">
  <div class="led-prism-wrapper" id="ledSign">
    <div class="led-prism">

      <!-- ÖN YÜZ (front) — ana logo & LED glow -->
      <div class="led-prism-face led-face-front">
        <div class="led-text-wrapper">
          <div class="led-text">
            <span class="led-daft">daft</span>
            <span class="led-coffee">coffee</span>
          </div>
        </div>
        <div class="led-divider"></div>
        <div class="led-icon-wrapper">
          <div class="led-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 6L4 22H10V40H38V22H44L24 6Z" stroke="#FFFFFF" stroke-width="1.5" fill="none"/>
            </svg>
            <span class="led-icon-text">daft</span>
          </div>
        </div>
      </div>

      <!-- ARKA YÜZ (back) -->
      <div class="led-prism-face led-face-back">
        <span class="led-back-text">daft coffee</span>
      </div>

      <!-- ÜST YÜZ (top) -->
      <div class="led-prism-face led-face-top"></div>

      <!-- ALT YÜZ (bottom) -->
      <div class="led-prism-face led-face-bottom"></div>

      <!-- SOL YÜZ (left) -->
      <div class="led-prism-face led-face-left"></div>

      <!-- SAĞ YÜZ (right) -->
      <div class="led-prism-face led-face-right"></div>

    </div>
  </div>


</section>

<!-- ===== KAMPANYALAR ===== -->
<section class="campaign-section fade-in-up">
  <h2>Kampanyalar</h2>
  <div class="campaign-card">
    <h3>Çok yakında...</h3>
    <p>Size özel fırsatlar burada olacak.</p>
  </div>
</section>

<!-- ===== İMZA LEZZETLERİMİZ ===== -->
<section class="signature-section fade-in-up">
  <h2>İmza Lezzetlerimiz</h2>
  <div class="signature-grid">
    
    <a href="/menu" class="signature-card">
      <img src="/images/defaults/kahve-default.png" alt="Daft Filtre" class="signature-thumb">
      <h3>Daft Filtre</h3>
      <p>Özenle kavrulmuş spesiyal çekirdeklerden, yumuşak içimli efsanevi klasiğimiz.</p>
    </a>

    <a href="/menu" class="signature-card">
      <img src="/images/defaults/tatli-default.png" alt="San Sebastian" class="signature-thumb">
      <h3>San Sebastian</h3>
      <p>Dışı hafif karamelize, içi akışkan krem peynir rüyası; kahvenin en iyi dostu.</p>
    </a>

    <a href="/menu" class="signature-card">
      <img src="/images/defaults/soguk-icecek-default.png" alt="Daft Cold Brew" class="signature-thumb">
      <h3>Daft Cold Brew</h3>
      <p>18 saat soğuk suda demlenmiş, asiditesi düşük, buz gibi güçlü bir enerji kaynağı.</p>
    </a>

  </div>
</section>

<%- include('partials/footer') %>
